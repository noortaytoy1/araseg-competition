# ---- Heavy / regenerable artifacts (kept out of version control) ----
# AraSeg corpus: download with `python data.py --task <T> --out-dir data`
data/
# Cached boundary probabilities (.npz) produced by cache_probs.py
probs/
# External corpora for the open track (OPUS / Wikipedia / Ashaar dumps)
ext/
# Submission CSVs / zips (regenerated by predict.py, ensemble_sweep.py, ...)
subs/
# Trained model checkpoints
runs/
# Training logs
logs/
# Redundant local backup of data/ + logs/
hiboss.zip

# ---- Official starter repo (clone separately; see README "Reproduce") ----
araseg-shared-task-2026/

# ---- LaTeX build artifacts (the .pdf and .tex/.md are tracked) ----
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz

